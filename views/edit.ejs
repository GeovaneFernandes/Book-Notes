<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <h1>Edit your book</h1>
    <h4>Edit the book information below:</h4>
    <hr />
    <form action="/update/<%= book[0].id %>" method="post">
      <label for="title">Title</label>
      <input type="text" name="title" id="title" value="<%= book[0].title %>" />
      <br />
      <br />
      <label for="description">Description</label>
      <textarea name="description" id="description">
      <%= book[0].description %>
      </textarea>
      <br /><br />
      <label for="read_date">Read Date</label>
      <input
        type="date"
        name="read_date"
        id="read_date"
        value="<%= book[0].read_date %>"
      />
      <br />
      <br />
      <label for="rate">Rate</label>
      <input type="number" name="rate" id="rate" value="<%= book[0].rate %>" />
      <br />
      <br />
      <button type="submit">Edit</button>
    </form>
  </body>
</html>
